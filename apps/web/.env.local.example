# Copy this file to .env.local and fill in your own values.
# See the root README.md for how to create these in Google Cloud Console.

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed if you're accessing dev through a tunnel (e.g. Cloudflare
# Tunnel) instead of http://localhost:3000 - pins the public URL Auth.js
# uses to build callback URLs and cookies, instead of guessing it from
# request headers.
# AUTH_URL=https://ytsort.slashsam.net
